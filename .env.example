# vidrag configuration — copy to data/.env and fill in.
# All persistent state (db / cookies / backups / this file) lives in data/.

# --- API keys (never commit, never log) ---
GROQ_API_KEY=
ANTHROPIC_API_KEY=

# --- PWA auth token (second layer on top of Tailscale) ---
APP_TOKEN=

# --- Budget & limits ---
MONTHLY_BUDGET_USD=5
MAX_VIDEO_DURATION_SECS=10800

# --- Model selection ---
# CHAT_MODEL_MODE: accurate (Sonnet for chat/vision) | budget (Haiku everywhere)
CHAT_MODEL_MODE=accurate

# --- Off-site encrypted backup (rule 16), optional ---
# Leave BACKUP_RCLONE_REMOTE empty to keep backups local-only. When set,
# each daily backup is age-encrypted and copied to this rclone remote.
# The age recipient (public key) must NOT be stored with the backups.
BACKUP_RCLONE_REMOTE=
BACKUP_AGE_RECIPIENT=
